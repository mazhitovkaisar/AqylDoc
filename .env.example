# "anthropic" (Claude API, платно, нужен для облачного деплоя) или "ollama" (бесплатно, только локально)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Раскомментируйте и укажите путь, если tesseract.exe не попал в PATH после установки:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
