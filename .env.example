# "anthropic" (платно, лучшее качество) / "ollama" (бесплатно, только локально) / "gemini" (бесплатно, работает и в облаке)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Раскомментируйте и укажите путь, если tesseract.exe не попал в PATH после установки:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
